---
# ==============================================================================
# ArgoCD Namespace & HelmChart Deployment Manifest
# Managed by RKE2 Helm Controller (/var/lib/rancher/rke2/server/manifests/)
# ==============================================================================
apiVersion: v1
kind: Namespace
metadata:
  name: argocd
  labels:
    app.kubernetes.io/name: argocd
    app.kubernetes.io/part-of: platform
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argo-cd
  namespace: kube-system
spec:
  chart: argo-cd
  repo: https://argoproj.github.io/argo-helm
  version: "{{ argocd_chart_version }}"
  targetNamespace: argocd
  createNamespace: true
  valuesContent: |-
    global:
      domain: "{{ argocd_hostname }}"
    server:
      extraArgs:
        - --insecure
      ingress:
        enabled: true
        ingressClassName: traefik
        hostname: "{{ argocd_hostname }}"
        https: false
        annotations:
          cert-manager.io/cluster-issuer: local-ca-issuer
          traefik.ingress.kubernetes.io/router.entrypoints: web,websecure
          traefik.ingress.kubernetes.io/service.serversscheme: http
        paths:
          - /
        pathType: Prefix
        extraTls:
          - hosts:
              - "{{ argocd_hostname }}"
            secretName: argocd-server-tls
    configs:
      params:
        server.insecure: true
      cm:
        kustomize.buildOptions: "--enable-alpha-plugins --enable-exec"
        resource.customizations.health.networking.k8s.io_Ingress: |-
          hs = {}
          hs.status = "Healthy"
          return hs
    repoServer:
      volumes:
        - name: ksops-bin
          hostPath:
            path: /usr/local/bin/ksops
            type: File
        - name: sops-age-key
          hostPath:
            path: /var/lib/sops-age/age.agekey
            type: File
        - name: custom-tools
          emptyDir: {}
      volumeMounts:
        - mountPath: /usr/local/bin/ksops
          name: ksops-bin
          readOnly: true
        - mountPath: /custom-tools
          name: custom-tools
        - mountPath: /var/run/secrets/sops/age/keys.txt
          name: sops-age-key
          readOnly: true
      initContainers:
        - name: install-ksops-plugin
          image: quay.io/argoproj/argocd:v2.13.3
          command: ["/bin/sh", "-c"]
          args:
            - mkdir -p /custom-tools/kustomize/plugin/viaduct.ai/v1/ksops /custom-tools/bin;
              cp /usr/local/bin/ksops /custom-tools/bin/ksops;
              cp /usr/local/bin/ksops /custom-tools/kustomize/plugin/viaduct.ai/v1/ksops/ksops;
              chmod 755 /custom-tools/bin/ksops /custom-tools/kustomize/plugin/viaduct.ai/v1/ksops/ksops;
          volumeMounts:
            - mountPath: /usr/local/bin/ksops
              name: ksops-bin
            - mountPath: /custom-tools
              name: custom-tools
      env:
        - name: XDG_CONFIG_HOME
          value: /custom-tools
        - name: PATH
          value: /custom-tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        - name: SOPS_AGE_KEY_FILE
          value: /var/run/secrets/sops/age/keys.txt
